# Public HTTPS origin, no trailing path. Add this host to your reverse proxy.
MES_ORIGIN=https://mes.th.io.vn
# Generate TWO distinct random hexadecimal passwords (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=replace_with_random_hex_admin_password
MES_DB_PASSWORD=replace_with_another_random_hex_runtime_password
OWNER_EMAIL=owner@example.com
# Optional Google OAuth; use MES_ORIGIN/api/oauth/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Drive uses MES_ORIGIN/api/mes/drive/callback.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_TRANSLATE_API_KEY=
STORAGE_QUOTA_BYTES=68719476736
